import assert from "node:assert/strict";
import { mkdtemp, mkdir, writeFile } from "node:fs/promises";
import { tmpdir } from "node:os";
import { join, resolve } from "node:path";
import { execFileSync } from "node:child_process";
import { chromium } from "playwright";
import { startConsole } from "../src/server.ts";
import { diffFile } from "../src/diff.ts";
const directory = await mkdtemp(join(tmpdir(), "review-redesign-")), root = join(directory,"repo");
await mkdir(root);
const git = (...args) => execFileSync("git",["-C",root,...args],{encoding:"utf8"}).trim();
git("init","-b","main"); await writeFile(join(root,"note.md"),"before\n"); git("add",".");
git("-c","user.name=Fixture","-c","user.email=test@example.test","commit","-m","Initial");
await writeFile(join(root,"note.md"),"staged\n");git("add",".");await writeFile(join(root,"note.md"),"working\n");
const service = await startConsole({directory,token:"redesign",web:resolve("dist/web")});
const post = async (path,body) => { const r=await fetch(service.origin+"/api/"+path,{method:"POST",headers:{Authorization:"Bearer redesign","Content-Type":"application/json"},body:JSON.stringify(body)});assert.ok(r.ok,await r.text()); };
await post("register",{cwd:root,sessionId:"a",title:"Fixture"});
for(const [id,files] of [["old",[]],["latest",[{path:"note.md",status:"Modified",added:1,deleted:1,diff:diffFile("note.md","before\n","working\n")}]]]) await post("round",{id,sessionId:"a",outcome:"completed",end:id==="old"?1:2,report:{id,cwd:root,start:1,end:2,outcome:"completed",prompts:["要求修改标题"],files,added:files.length,deleted:files.length}});
const browser=await chromium.launch({headless:true,channel:"chrome"});
const page=await browser.newPage({viewport:{width:1440,height:900}}), errors=[];
page.on("pageerror",e=>errors.push(e.message));
const shots=resolve("test-results/redesign");await mkdir(shots,{recursive:true});
try {
 await page.goto(service.origin+"/#token=redesign&session=a");
 await page.locator(".round-context[open]").waitFor();
 assert.match(await page.locator(".round-context").textContent(),/要求修改标题/);
 await page.locator(".project small",{hasText:"main"}).waitFor();
 assert.equal(await page.locator(".project-count").textContent(),"1");
 await page.selectOption("#rounds","old");await page.waitForFunction(()=>document.querySelector("#file-count").textContent==="0");
 assert.equal(await page.locator(".project-count").textContent(),"1");
 assert.equal(await page.locator("#changed-layout").isVisible(),false,"本轮无改动时不显示 Tree/Flat");
 await page.click(".content-pane .pane-toggle");
 assert.equal(await page.locator("#files-pane").evaluate(el=>el.classList.contains("collapsed")),false,"收起内容栏不连带收起文件栏");
 await page.click(".content-pane .rail-button");
 assert.equal(await page.locator("#content-pane").evaluate(el=>el.classList.contains("collapsed")),false);
 await page.selectOption("#rounds","latest");await page.waitForFunction(()=>document.querySelector("#changed-layout").hidden===false);
 await page.selectOption("#font","serif");
 assert.equal(await page.evaluate(()=>document.documentElement.dataset.font),"serif");
 assert.match(await page.locator("#document").evaluate(el=>getComputedStyle(el).fontFamily),/Charter/);
 await page.selectOption("#font","system");
 await page.click('[data-layout="split"]');
 assert.equal(await page.locator('[data-wrap]').isChecked(),true);
 assert.ok(await page.locator("#reply-pane").evaluate(el=>el.getBoundingClientRect().width>=360));
 await page.screenshot({path:join(shots,"review.png")});
 await page.click("#history-tab");await page.locator(".commit-card").waitFor();
 assert.equal(await page.locator("#review-index").isVisible(),false);
 assert.match(await page.locator("#git-index").textContent(),/已暂存/);
 await page.locator(".workspace-file").first().click();await page.locator(".file-toolbar",{hasText:"HEAD → index"}).waitFor();
 assert.match(await page.locator("#content").textContent(),/staged/);
 assert.doesNotMatch(await page.locator("#content").textContent(),/working/);
 await page.locator(".workspace-file").nth(1).click();
 await page.locator(".file-toolbar",{hasText:"index → working tree"}).waitFor();
 await page.waitForFunction(()=>document.querySelector("#content").textContent.includes("working") && !document.querySelector("#content").textContent.includes("new working content"));
 await writeFile(join(root,"note.md"),"new working content\n");
 await page.evaluate(()=>window.dispatchEvent(new Event("focus")));
 await page.waitForFunction(()=>document.querySelector("#content").textContent.includes("new working content"),undefined,{timeout:3000});
 await page.screenshot({path:join(shots,"git.png")});
 await page.click("#theme");await page.screenshot({path:join(shots,"light-charcoal.png")});
 await page.selectOption("#paper","ivory");await page.screenshot({path:join(shots,"light-ivory.png")});
 await page.click("#theme");
 assert.equal(await page.locator("#paper").inputValue(),"ivory");
 await page.screenshot({path:join(shots,"ivory.png")});
 const scratch=await browser.newPage({viewport:{width:1280,height:850}});
 scratch.on("pageerror",e=>errors.push(e.message));
 await scratch.goto(service.origin+"/scratch");
 await scratch.click("#new-doc");await scratch.getByRole("textbox",{name:"Markdown source",exact:true}).fill("# 临时文档\n\n**正文**");
 await scratch.locator(".scratch-preview h1",{hasText:"临时文档"}).waitFor();
 await scratch.click('[data-view="preview"]');await scratch.click('[data-view="source"]');
 assert.match(await scratch.getByRole("textbox",{name:"Markdown source",exact:true}).innerText(),/正文/);
 await scratch.click("#new-diff");await scratch.getByRole("textbox",{name:"旧文本",exact:true}).fill("old\n");await scratch.getByRole("textbox",{name:"新文本",exact:true}).fill("new\n");
 await scratch.click('[data-view="diff"]');await scratch.locator("td.content.insert").waitFor();
 assert.match(await scratch.locator("td.content.delete").textContent(),/old/);
 await scratch.click("#tabs-layout");await scratch.screenshot({path:join(shots,"scratch.png")});
 scratch.once("dialog",d=>d.dismiss());await scratch.locator(".tab-close").last().click();
 assert.equal(await scratch.locator('[role="tab"]').count(),2);
 scratch.once("dialog",d=>d.accept());await scratch.locator(".tab-close").last().click();
 await scratch.click('[role="tab"]');await scratch.click('[data-view="split"]');
 assert.match(await scratch.getByRole("textbox",{name:"Markdown source",exact:true}).innerText(),/正文/);
 assert.deepEqual(errors,[]);
 console.log(JSON.stringify({passed:true,directory,screenshots:shots}));
} finally {await browser.close();await service.close();}
