{
  "name": "pi-review-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local multi-project review console for pi",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "pi": {
    "extensions": [
      "./dist/extension.mjs"
    ]
  },
  "files": [
    "dist",
    "README.md",
    "migration"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "test:redesign": "node --experimental-strip-types test/redesign.mts",
    "test:diff": "node --experimental-strip-types test/diff-fold.mts",
    "test:performance": "node --experimental-strip-types test/performance.mts",
    "test:polish": "node --experimental-strip-types --test test/polish.mts",
    "test:editor": "node --experimental-strip-types --test test/editor.mts",
    "test:files": "node --experimental-strip-types --test test/file-explorer.mts test/file-actions.test.ts",
    "pretest:desktop": "npm run build:desktop -- --e2e",
    "test:desktop": "node --experimental-strip-types test/desktop.mts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts && npm run test:go",
    "test:go": "cd desktop && go test ./...",
    "test:e2e": "node --experimental-strip-types test/browser.mts",
    "test:visual": "node --experimental-strip-types test/visual.mts",
    "verify:package": "node --experimental-strip-types test/package.mts",
    "verify:migration": "node --experimental-strip-types test/migration.mts",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node dist/cli.mjs",
    "stop": "node dist/cli.mjs stop",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@lezer/highlight": "^1.2.5",
    "@mdit/plugin-katex": "1.1.4",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.1",
    "diff": "^8.0.4",
    "esbuild": "^0.28.2",
    "function-plot": "1.26.0",
    "highlight.js": "^11.12.0",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-mark": "4.0.0",
    "markdown-it-sub": "2.0.0",
    "markdown-it-sup": "2.0.0",
    "markdown-it-task-lists": "2.1.1",
    "pele": "1.9.0",
    "playwright": "^1.56.0",
    "postcss": "^8.5.0",
    "typescript": "^5.9.3",
    "ws": "^8.22.0"
  },
  "overrides": {
    "undici": "8.12.2"
  }
}
