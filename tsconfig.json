{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "allowJs": true, "checkJs": false, "skipLibCheck": true,
    "lib": ["ES2023", "DOM"], "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.test.ts"]
}
